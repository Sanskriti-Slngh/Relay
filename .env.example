# Configure stable identities; do not regenerate them between restarts.
CLUB_WORKSPACE_ID=replace-with-stable-club-workspace-id
OFFICER_USER_ID=replace-with-stable-officer-user-id

# Supply a locally generated 32-byte random value encoded as unpadded base64url.
# This placeholder is intentionally invalid and is not an access credential.
LOCAL_ACCESS_CREDENTIAL=REPLACE_WITH_43_CHAR_BASE64URL_TOKEN

# Use a MongoDB URI with an explicit database name.
MONGODB_URL=mongodb://127.0.0.1:27018/relay?replicaSet=rs0

# Optional HTTP port. The host always binds to 127.0.0.1.
# PORT=3000

# Optional: override only the database name for an isolated local demo.
# Choose a fresh name for a clean workspace; it must differ from the URI's database.
# RELAY_DEMO_DATABASE=relay_demo_fresh
